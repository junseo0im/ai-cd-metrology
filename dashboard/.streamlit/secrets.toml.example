# 예시 파일입니다. 실제 값은 같은 폴더의 secrets.toml(Git 제외)에만 두세요. 이 파일에는 인증값을 넣지 않습니다.
# 모든 항목은 선택입니다. 없으면 GUEST 조회 모드 / MLflow 기본 주소(인증 없음)로 동작합니다.

# 단일 관리자 계정 (dashboard/auth.py). 비밀번호는 평문으로 쓰지 말고 아래 명령으로 해시를 생성하세요:
#   dashboard\.venv\Scripts\python.exe -B -m dashboard.auth --setup
# (환경변수 IDA_ADMIN_USERNAME / IDA_ADMIN_PASSWORD_HASH / IDA_ADMIN_DISPLAY_NAME 가 있으면 그것이 우선)
[ida_admin]
username = ""
password_hash = ""
display_name = "ADMIN"

# MLflow 조회 (dashboard/mlflow_provider.py). 환경변수 MLFLOW_TRACKING_URI / _USERNAME / _PASSWORD / _TOKEN 이 우선합니다.
[mlflow]
tracking_uri = ""
username = ""
password = ""
token = ""
